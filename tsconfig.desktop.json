  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node",
    "lib": ["ES2022", "DOM"], "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "outDir": "desktop-dist", "rootDir": ".",
    "types": ["node"]

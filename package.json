{
  "name": "desktop-starter",
  "productName": "Desktop Starter",
  "version": "0.3.0",
  "private": true,
  "description": "基于 Credit UI 的通用 Electron 桌面客户端底座",
  "author": "Desktop Starter contributors",
  "license": "Apache-2.0",
  "main": "desktop-dist/desktop/main.js",
  "scripts": {
    "setup": "node scripts/themes.mjs && install-electron",
    "dev": "node scripts/dev.mjs",
    "dev:ui": "next dev --hostname 127.0.0.1 --port 3014",
    "build:desktop": "tsc -p tsconfig.desktop.json",
    "build:ui": "node scripts/themes.mjs && next build",
    "build": "corepack pnpm build:desktop && corepack pnpm build:ui",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/smoke.mjs",
    "test:dev": "node scripts/dev-smoke.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.desktop.json --noEmit",
    "pack": "corepack pnpm build && electron-builder --win --x64 --dir --publish never",
    "dist:win": "corepack pnpm build && electron-builder --win nsis --x64 --publish never",
    "test:stability": "node scripts/stability-smoke.mjs",
    "dist:portable": "corepack pnpm build && electron-builder --win portable --x64 --publish never",
    "test:maturity": "node scripts/maturity-smoke.mjs",
    "test:updater": "node scripts/updater-smoke.mjs"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tailwindcss/postcss": "4.1.18",
    "@tailwindcss/typography": "0.5.19",
    "@types/node": "22.19.15",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "lucide-react": "0.552.0",
    "next": "16.3.3",
    "playwright": "1.64.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.21.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "sharp",
      "unrs-resolver",
      "esbuild"
    ]
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9"
  }
}
